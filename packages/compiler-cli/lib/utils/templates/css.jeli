(function(){ "use strict"; const head = document.getElementsByTagName("head")[0]; const appId = <%=appId%>; Array.prototype.forEach.call(head.querySelectorAll('style[data-jeli-style="' + appId + '"]'), function(el){ el.parentNode.removeChild(el); }); [<%=styles%>].forEach(writeCssToDOM); function writeCssToDOM(css){ 'use strict'; if(!css) return; var element = document.createElement("style"); element.setAttribute("type", "text/css"); element.setAttribute("data-jeli-style", appId); element.appendChild(document.createTextNode(css)); head.appendChild(element); }})();